{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SmythOS Backend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/app/dist/server/index.js",
      "cwd": "${workspaceFolder}/packages/app",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/app/dist/**/*.js"],
      "preLaunchTask": "build-backend",
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "runtimeArgs": ["--enable-source-maps"]
    },
    {
      "name": "Debug SmythOS Backend (No Build)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/app/dist/server/index.js",
      "cwd": "${workspaceFolder}/packages/app",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/app/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "runtimeArgs": ["--enable-source-maps"]
    },
    {
      "name": "Debug SmythOS Backend (TypeScript)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/app/src/backend/index.ts",
      "cwd": "${workspaceFolder}/packages/app",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--loader", "ts-node/esm", "--enable-source-maps"],
      "skipFiles": ["<node_internals>/**"],
      "restart": true
    },
    {
      "name": "Attach to SmythOS Backend",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "localRoot": "${workspaceFolder}/packages/app",
      "remoteRoot": "${workspaceFolder}/packages/app",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/app/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
