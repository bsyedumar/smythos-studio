{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-backend",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "build:backend"],
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/packages/app"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build-frontend",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "build:frontend"],
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/packages/app"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build-all",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "bundle:dev"],
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/packages/app"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": ["$tsc"],
      "dependsOrder": "sequence"
    },
    {
      "label": "start-dev-server",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev"],
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/packages/app"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*\\[?\\d+:\\d+:\\d+\\]?\\s*(Starting|Restarting)",
          "endsPattern": "^\\s*\\[?\\d+:\\d+:\\d+\\]?\\s*(Finished|Completed|Done)"
        }
      }
    }
  ]
}
